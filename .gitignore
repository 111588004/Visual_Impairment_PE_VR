# This .gitignore file ensures that you do not commit generated files and build artifacts to your repository.

# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive
/[Mm]emoryCaptures/

# Generated gaze-tracking CSV logs (see GazeDataRecorder.cs)
/[Aa]ssets/Data/GazeLogs/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage

# Crashlytics generated file
crashlytics-build.properties

# Urp / Hdrp / ShaderGraph
*BurstDebugInformation_DoNotShip/
/[Aa]ssets/**/LightingData.asset

# Local Build Folders
.utmp/

# Scratch analysis scripts / tech docs (not part of the Unity project)
*.ps1
*.py
*_tech_doc.html
*_tech_doc.md
*.xlsx
find_recent_cs.py
glaucoma_projection_diagram.png
glaucoma_transition_modes.png
diag_maincam.png

# Unity crash-recovery scene backups (auto-generated on Editor crash)
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta

# Rejected/disabled community OpenXR workaround (kept for reference, not part of the shipping project)
/[Aa]ssets/_Core/Scripts/Common/OpenXR/
/[Aa]ssets/_Core/Scripts/Common/OpenXR.meta

# Claude Code local config
/.claude/

# Third-party commercial assets (license prohibits redistribution)
/[Aa]ssets/_ThirdParty/

# Personal work log (not for the public repo)
/PROJECT_LOG.md

# Personal reference documents (copyrighted / third-party material, keep local)
/docs/*.pdf
